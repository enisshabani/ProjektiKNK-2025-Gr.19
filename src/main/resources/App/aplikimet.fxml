<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" prefHeight="700" prefWidth="1000" stylesheets="@styles.css" fx:controller="Controller.AplikimetController">
<top>
<HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
<children>
<Label styleClass="top-title" text="Dormitory Management System"/>
<Region HBox.hgrow="ALWAYS"/>
<Label styleClass="language-switch" text="EN | SQ"/>
<Button fx:id="accountButton" styleClass="top-button" text="Account"/>
<Button fx:id="logoutButton" styleClass="top-button" text="Logout"/>
</children>
</HBox>
</top>
<left>
<fx:include source="sidebar.fxml"/>
</left>
<center>
<VBox spacing="10" style="-fx-padding: 20;">
<children>
<Label styleClass="section-title" text="Lista e Studentëve"/>
<HBox alignment="CENTER_LEFT" spacing="10">
<children>
<TextField fx:id="searchField" promptText="Kërko student..."/>
<ComboBox fx:id="filterStatus" promptText="Filtroni statusin"/>
<Button onAction="#applyFilters" text="Kërko"/>
</children>
</HBox>
<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
<content>
<TableView fx:id="applicationsTable" prefHeight="200.0" prefWidth="200.0">
<columns>
<TableColumn fx:id="idColumn" prefWidth="75.0" text="ID"/>
<TableColumn fx:id="nameColumn" prefWidth="125.60003662109375" text="Studenti"/>
<TableColumn fx:id="dateColumn" prefWidth="130.40003967285156" text="Data e Aplikimit"/>
<TableColumn fx:id="statusColumn" prefWidth="127.20001220703125" text="Statusi"/>
<TableColumn fx:id="actionsColumn" prefWidth="192.7999267578125" text="Veprimi"/>
</columns>
</TableView>
</content>
</ScrollPane>
</children>
</VBox>
</center>
<bottom>
<HBox alignment="CENTER_LEFT" spacing="10" styleClass="status-bar">
<padding>
<Insets bottom="5" left="10" right="10" top="5"/>
</padding>
<children>
<Label fx:id="statusLabel" text="Ready | Admin logged in"/>
</children>
</HBox>
</bottom>
</BorderPane>