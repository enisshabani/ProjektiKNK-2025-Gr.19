<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1000" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.RoomDetailsController">

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <Label styleClass="section-title" text="Lista e dhomave te studentëve" />

            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="searchField" promptText="Kërko dhomen..." />
                <Button fx:id="searchButton" onAction="#applyFilters" text="Kërko" />
            </HBox>

            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <TableView fx:id="roomTable" minWidth="950" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="40" text="ID" />
                        <TableColumn fx:id="firstNameColumn" prefWidth="100" text="Emri" />
                        <TableColumn fx:id="lastNameColumn" prefWidth="100" text="Mbiemri" />
                        <TableColumn fx:id="roomColumn" prefWidth="150" text="Numri i Dhomes" />
                        <TableColumn fx:id="genderColumn" prefWidth="80" text="Gjinia" />
                        <TableColumn fx:id="roomstatusColumn" prefWidth="120" text="Statusi i Dhomes" />
                        <TableColumn fx:id="buildingidColumn" prefWidth="82.67" text="Ndertesa" />
                        <TableColumn fx:id="capacityColumn" prefWidth="106.0" text="Kapaciteti" />
                    </columns>
                </TableView>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="status-bar">
            <padding>
                <Insets bottom="5" left="10" right="10" top="5" />
            </padding>
            <Label fx:id="statusLabel" text="Ready | Admin logged in" />
        </HBox>
    </bottom>

</BorderPane>