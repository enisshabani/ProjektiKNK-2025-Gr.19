<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.RoomDetailsController">

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <Label styleClass="section-title" text="Lista e dhomave te studentëve"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="addButton" text="Add"/>
                <Button fx:id="editButton" text="Edit"/>
                <Button fx:id="deleteButton" text="Delete"/>
                <TextField fx:id="searchField" promptText="Search..."/>
                <Button fx:id="searchButton" text="Search"/>
                <Button fx:id="languageButton" text="AL | EN"/>
            </HBox>

            <TableView fx:id="roomTable">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="firstNameColumn" text="First Name" prefWidth="100"/>
                    <TableColumn fx:id="lastNameColumn" text="Last Name" prefWidth="100"/>
                    <TableColumn fx:id="roomColumn" text="Room Number" prefWidth="100"/>
                    <TableColumn fx:id="genderColumn" text="Gender" prefWidth="80"/>
                    <TableColumn fx:id="roomstatusColumn" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="buildingidColumn" text="Building" prefWidth="100"/>
                    <TableColumn fx:id="capacityColumn" text="Capacity" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="status-bar">
            <Label fx:id="statusLabel" text="Ready | Admin logged in"/>
        </HBox>
    </bottom>
</BorderPane>