<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.web.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.HelpController"
            stylesheets="@styles.css">

    <!-- Top Bar -->
    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <!-- Sidebar -->
    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <!-- Main Help Content -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="help-scroll">
            <VBox spacing="20" alignment="TOP_LEFT" styleClass="help-content">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <!-- FAQs with dropdowns -->
                <Label text="Pyetje të shpeshta:" styleClass="section-title" />

                <TitledPane text=" Si të regjistrohem?" expanded="false">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Ju duhet të shkoni te faqja e regjistrimit dhe të plotësoni formularin me të dhënat tuaja personale." wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane text=" Nuk mund të kyçem në sistem" expanded="false">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Sigurohuni që keni futur emailin dhe fjalëkalimin e saktë. Nëse keni harruar fjalëkalimin, përdorni funksionin 'Harruat fjalëkalimin?'" wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane text=" A mund të ndryshoj dhomën pas aprovimit?" expanded="false">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Po, ju mund të kërkoni ndërrim të dhomës përmes një kërkese të re të brendshme në platformë." wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane text=" Si të ndryshoj fjalëkalimin?" expanded="false">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Shkoni te llogaria juaj dhe klikoni 'Ndrysho fjalëkalimin'. Plotësoni të dhënat dhe ruani ndryshimet." wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane text=" Si të kontrolloj statusin e aplikimit?" expanded="false">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Pasi të aplikoni, vizitoni seksionin 'Aplikimet' për të parë statusin tuaj në kohë reale." wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane text=" A ka ndihmë në dy gjuhë?" expanded="false">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Po, sistemi ofron mbështetje në gjuhën shqipe dhe angleze. Ju mund të ndërroni gjuhën nga menuja në krye." wrapText="true" />
                    </VBox>
                </TitledPane>

                <!-- Contact Info -->
                <Label text="Kontakt:" styleClass="section-title" />
                <VBox spacing="4" style="-fx-background-color: #f9f9f9; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;">
                    <Label text="📧 Email: fiek@uni-pr.edu" styleClass="contact-info" />
                    <Label text="📞 Telefoni: +383 49 123 456" styleClass="contact-info" />
                    <Label text="📍 Adresa: Rr. Bregu i Diellit, Prishtinë" styleClass="contact-info" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>