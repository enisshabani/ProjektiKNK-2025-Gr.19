<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@styles.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="Controller.HelpController">

    <!-- Top Bar -->
    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <Label styleClass="top-title" text="Dormitory Management System" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="language-switch" text="EN | SQ" />
            <Button fx:id="accountButton" styleClass="top-button" text="Account" />
            <Button fx:id="logoutButton" styleClass="top-button" text="Logout" />
        </HBox>
    </top>

    <!-- Sidebar -->
    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <!-- Main Help Content -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="help-scroll">
            <VBox alignment="TOP_LEFT" spacing="20" styleClass="help-content">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <!-- FAQs with dropdowns -->
                <Label styleClass="section-title" text="Pyetje të shpeshta:" />

                <TitledPane expanded="false" text=" Si të regjistrohem?">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Ju duhet të shkoni te faqja e regjistrimit dhe të plotësoni formularin me të dhënat tuaja personale." wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane expanded="false" text=" Nuk mund të kyçem në sistem">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Sigurohuni që keni futur emailin dhe fjalëkalimin e saktë. Nëse keni harruar fjalëkalimin, përdorni funksionin 'Harruat fjalëkalimin?'" wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane expanded="false" text=" A mund të ndryshoj dhomën pas aprovimit?">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Po, ju mund të kërkoni ndërrim të dhomës përmes një kërkese të re të brendshme në platformë." wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane expanded="false" text=" Si të ndryshoj fjalëkalimin?">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Shkoni te llogaria juaj dhe klikoni 'Ndrysho fjalëkalimin'. Plotësoni të dhënat dhe ruani ndryshimet." wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane expanded="false" text=" Si të kontrolloj statusin e aplikimit?">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Pasi të aplikoni, vizitoni seksionin 'Aplikimet' për të parë statusin tuaj në kohë reale." wrapText="true" />
                    </VBox>
                </TitledPane>

                <TitledPane expanded="false" text=" A ka ndihmë në dy gjuhë?">
                    <VBox>
                        <padding><Insets top="10" /></padding>
                        <Label text="Po, sistemi ofron mbështetje në gjuhën shqipe dhe angleze. Ju mund të ndërroni gjuhën nga menuja në krye." wrapText="true" />
                    </VBox>
                </TitledPane>

                <!-- Contact Info -->
                <Label styleClass="section-title" text="Kontakt:" />
                <VBox spacing="4" style="-fx-background-color: #f9f9f9; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;">
                    <Label styleClass="contact-info" text="📧 Email: fiek@uni-pr.edu" />
                    <Label styleClass="contact-info" text="📞 Telefoni: +383 49 123 456" />
                    <Label styleClass="contact-info" text="📍 Adresa: Rr. Bregu i Diellit, Prishtinë" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
